---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  { number: "01", title: "CONCEPT", description: "Every NOVARA design begins with an idea. We explore modern fashion, identity, and simplicity." },
  { number: "02", title: "DESIGN", description: "We develop clean silhouettes, thoughtful details, and timeless visual concepts." },
  { number: "03", title: "CREATION", description: "The concepts are transformed into clothing pieces with attention to design and presentation." },
  { number: "04", title: "EXPRESSION", description: "The final collection becomes a way for individuals to express their own identity." }
];
---

<BaseLayout title="Our Process | NOVARA">
  <section class="bg-neutral-100 px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="mx-auto max-w-[1440px]">
      <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-neutral-500">Behind the brand / 04</span>
      <h1 data-text-reveal class="mt-7 text-[clamp(3.8rem,11vw,9rem)] font-black uppercase leading-[0.84] tracking-[-0.08em]">From idea<br />to <span class="text-neutral-400">identity.</span></h1>
      <p class="mt-8 text-sm leading-7 text-neutral-600">Every detail has a purpose. Every design tells a story.</p>
    </div>
  </section>
  <section data-pin-section class="mx-auto grid max-w-[1440px] gap-10 px-5 py-20 sm:px-8 sm:py-28 md:grid-cols-[0.8fr_1.2fr] md:gap-20 lg:px-12">
    <div data-pin class="self-start"><span class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500">The NOVARA method</span><h2 data-text-reveal class="mt-5 text-4xl font-black uppercase leading-[0.92] tracking-[-0.06em] sm:text-5xl">Our creative<br />process.</h2></div>
    <div data-stagger class="divide-y divide-neutral-200 border-y border-neutral-200">
      {steps.map((step) => (
        <article class="grid grid-cols-[2rem_1fr_auto] items-start gap-4 py-7 sm:grid-cols-[3rem_1fr_auto] sm:gap-6">
          <span class="pt-1 text-xs text-neutral-400">{step.number}</span>
          <div><h3 class="text-base font-bold tracking-wide">{step.title}</h3><p class="mt-2 max-w-md text-sm leading-6 text-neutral-600">{step.description}</p></div>
          <span class="text-xl" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>
  <section class="relative h-[420px] overflow-hidden bg-neutral-950 sm:h-[560px]">
    <img data-parallax class="h-full w-full object-cover opacity-60" src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=1800&q=85" alt="Clothing design and apparel production" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/50 to-transparent"></div>
    <div class="absolute bottom-10 left-5 text-white sm:bottom-14 sm:left-8 lg:left-12"><span class="text-[10px] font-bold uppercase tracking-[0.2em]">The details matter.</span><h2 class="mt-4 text-5xl font-black uppercase leading-[0.9] tracking-[-0.06em] sm:text-7xl">Built with<br />purpose.</h2></div>
  </section>
</BaseLayout>
