
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | NOVARA">

  <section class="contact-hero">
    <span class="section-label">LET'S CONNECT / 05</span>
    <h1>LET'S TALK<br /><span>FASHION.</span></h1>
    <p>Have questions or want to know more about NOVARA? We'd love to hear from you.</p>
  </section>

  <section class="contact-content">

    <div class="contact-info">
      <span class="section-label">GET IN TOUCH</span>
      <h2>START A<br />CONVERSATION.</h2>

      <div class="info-item">
        <span>EMAIL</span>
        <p>hello@novara.com</p>
      </div>

      <div class="info-item">
        <span>LOCATION</span>
        <p>Philippines</p>
      </div>

      <div class="info-item">
        <span>SOCIAL MEDIA</span>
        <p>Instagram / Facebook</p>
      </div>
    </div>

    <form class="contact-form" action="https://formsubmit.co/your-email@example.com" method="POST">
      <input type="hidden" name="_subject" value="New NOVARA Website Inquiry" />
      <input type="hidden" name="_captcha" value="true" />

      <label for="name">YOUR NAME</label>
      <input type="text" id="name" name="name" placeholder="Enter your name" required />

      <label for="email">EMAIL ADDRESS</label>
      <input type="email" id="email" name="email" placeholder="Enter your email" required />

      <label for="subject">SUBJECT</label>
      <input type="text" id="subject" name="subject" placeholder="What is this about?" required />

      <label for="message">YOUR MESSAGE</label>
      <textarea id="message" name="message" rows="5" placeholder="Write your message..." required></textarea>

      <button type="submit">SEND MESSAGE ↗</button>
    </form>

  </section>

  <section class="contact-bottom">
    <h2>THANK YOU FOR<br />CHOOSING NOVARA.</h2>
    <p>MINIMAL DESIGN. TIMELESS IDENTITY.</p>
  </section>

</BaseLayout>

<style>
  .contact-hero {
    background: #f3f3f3;
    padding: 120px 7%;
  }

  .contact-hero h1 {
    font-size: clamp(60px, 11vw, 135px);
    font-weight: 900;
    line-height: .9;
    letter-spacing: -8px;
    margin: 35px 0;
  }

  .contact-hero h1 span { color: #999; }

  .contact-hero p {
    color: #777;
    max-width: 430px;
    font-size: 14px;
    line-height: 1.9;
  }

  .contact-content {
    padding: 120px 7%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }

  .contact-info h2 {
    font-size: 55px;
    line-height: .95;
    letter-spacing: -3px;
    margin: 30px 0 55px;
  }

  .info-item {
    border-top: 1px solid #ddd;
    padding: 22px 0;
  }

  .info-item span, .contact-form label {
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 700;
  }

  .info-item p {
    color: #777;
    font-size: 13px;
    margin-top: 12px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
  }

  .contact-form label { margin-bottom: 12px; }

  .contact-form input,
  .contact-form textarea {
    padding: 16px 0;
    border: none;
    border-bottom: 1px solid #ccc;
    margin-bottom: 30px;
    outline: none;
    font-family: inherit;
    font-size: 13px;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: black;
  }

  .contact-form button {
    border: none;
    background: black;
    color: white;
    padding: 20px;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: .3s;
  }

  .contact-form button:hover {
    background: #444;
  }

  .contact-bottom {
    background: #080808;
    color: white;
    padding: 100px 7%;
    text-align: center;
  }

  .contact-bottom h2 {
    font-size: clamp(40px, 7vw, 75px);
    letter-spacing: -4px;
    line-height: .95;
  }

  .contact-bottom p {
    font-size: 10px;
    color: #888;
    letter-spacing: 3px;
    margin-top: 30px;
  }

  @media(max-width: 750px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .contact-hero h1 { letter-spacing: -4px; }
  }
</style>
