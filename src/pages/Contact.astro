---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | NOVARA">
  <section class="bg-neutral-100 px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="mx-auto max-w-[1440px]">
      <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-neutral-500">Let's connect / 05</span>
      <h1 data-text-reveal class="mt-7 text-[clamp(3.7rem,11vw,9rem)] font-black uppercase leading-[0.84] tracking-[-0.08em]">Let's talk<br /><span class="text-neutral-400">fashion.</span></h1>
      <p class="mt-8 max-w-lg text-sm leading-7 text-neutral-600 sm:text-base">Have questions or want to know more about NOVARA? We'd love to hear from you.</p>
    </div>
  </section>
  <section data-stagger class="mx-auto grid max-w-[1440px] gap-12 px-5 py-20 sm:px-8 sm:py-28 md:grid-cols-2 md:gap-20 lg:px-12">
    <div>
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500">Get in touch</span>
      <h2 data-text-reveal class="mt-5 text-4xl font-black uppercase leading-[0.92] tracking-[-0.06em] sm:text-5xl">Start a<br />conversation.</h2>
      <div class="mt-12 divide-y divide-neutral-200 border-y border-neutral-200">
        <div class="py-5"><span class="text-[10px] font-bold tracking-[0.17em]">EMAIL</span><p class="mt-2 text-sm text-neutral-600"><a class="hover:text-neutral-950" href="mailto:hello@novara.com">hello@novara.com</a></p></div>
        <div class="py-5"><span class="text-[10px] font-bold tracking-[0.17em]">LOCATION</span><p class="mt-2 text-sm text-neutral-600">Philippines</p></div>
        <div class="py-5"><span class="text-[10px] font-bold tracking-[0.17em]">SOCIAL MEDIA</span><p class="mt-2 text-sm text-neutral-600">Instagram / Facebook</p></div>
      </div>
    </div>
    <form class="flex flex-col" action="mailto:hello@novara.com" method="POST" enctype="text/plain">
      <label class="mb-2 text-[10px] font-bold tracking-[0.17em]" for="name">YOUR NAME</label>
      <input class="mb-7 border-b border-neutral-300 bg-transparent px-0 py-3 text-sm outline-none placeholder:text-neutral-400 focus:border-neutral-950 focus:ring-0" type="text" id="name" name="name" placeholder="Enter your name" autocomplete="name" required />
      <label class="mb-2 text-[10px] font-bold tracking-[0.17em]" for="email">EMAIL ADDRESS</label>
      <input class="mb-7 border-b border-neutral-300 bg-transparent px-0 py-3 text-sm outline-none placeholder:text-neutral-400 focus:border-neutral-950 focus:ring-0" type="email" id="email" name="email" placeholder="Enter your email" autocomplete="email" required />
      <label class="mb-2 text-[10px] font-bold tracking-[0.17em]" for="subject">SUBJECT</label>
      <input class="mb-7 border-b border-neutral-300 bg-transparent px-0 py-3 text-sm outline-none placeholder:text-neutral-400 focus:border-neutral-950 focus:ring-0" type="text" id="subject" name="subject" placeholder="What is this about?" required />
      <label class="mb-2 text-[10px] font-bold tracking-[0.17em]" for="message">YOUR MESSAGE</label>
      <textarea class="mb-8 resize-y border-b border-neutral-300 bg-transparent px-0 py-3 text-sm outline-none placeholder:text-neutral-400 focus:border-neutral-950 focus:ring-0" id="message" name="message" rows="5" placeholder="Write your message..." required></textarea>
      <button data-magnetic class="inline-flex items-center justify-center gap-3 bg-neutral-950 px-6 py-4 text-[10px] font-bold tracking-[0.15em] text-white transition hover:bg-lime-400 hover:text-neutral-950" type="submit">SEND MESSAGE <span aria-hidden="true">↗</span></button>
    </form>
  </section>
  <section class="bg-neutral-950 px-5 py-20 text-center text-white sm:px-8 sm:py-28">
    <h2 data-text-reveal class="text-4xl font-black uppercase leading-[0.92] tracking-[-0.06em] sm:text-6xl">Thank you for<br />choosing NOVARA.</h2>
    <p class="mt-6 text-[10px] font-semibold tracking-[0.2em] text-neutral-400">MINIMAL DESIGN. TIMELESS IDENTITY.</p>
  </section>
</BaseLayout>
