---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="NOVARA | Modern Streetwear">
  <section class="mx-auto grid max-w-[1440px] gap-10 px-5 py-12 sm:px-8 sm:py-16 md:grid-cols-[0.9fr_1.1fr] md:items-center md:gap-14 md:px-12 md:py-20">
    <div class="max-w-xl py-4">
      <span class="text-[10px] font-bold uppercase tracking-[0.24em] text-neutral-500">Est. 2026 / Modern streetwear</span>
      <h1 data-text-reveal class="mt-7 text-[clamp(3.5rem,9vw,7.8rem)] font-black uppercase leading-[0.84] tracking-[-0.075em]">Wear your<br /><span class="text-neutral-400">identity.</span></h1>
      <p class="mt-7 max-w-md text-sm leading-7 text-neutral-600 sm:text-base">More than clothing. A statement of individuality, confidence, and modern expression.</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a data-magnetic href="/Projects" class="inline-flex items-center gap-3 bg-neutral-950 px-6 py-4 text-[10px] font-bold uppercase tracking-[0.15em] text-white hover:bg-lime-400 hover:text-neutral-950">Explore collection <span aria-hidden="true">↗</span></a>
        <a href="/About" class="text-[10px] font-bold uppercase tracking-[0.15em] hover:text-neutral-500">Discover NOVARA</a>
      </div>
      <p class="mt-12 hidden text-[10px] font-semibold tracking-[0.18em] text-neutral-400 md:block">01 / 04 <span class="ml-3 inline-block h-px w-14 bg-neutral-300 align-middle"></span></p>
    </div>
    <figure data-image-reveal class="group relative h-[420px] overflow-hidden bg-neutral-100 sm:h-[560px] md:h-[min(68vw,680px)]">
      <img class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1400&q=85" alt="Modern streetwear fashion model" />
      <figcaption class="absolute bottom-5 left-5 bg-white px-4 py-3 text-[9px] font-bold uppercase tracking-[0.18em] sm:bottom-7 sm:left-7">NOVARA / Collection 001</figcaption>
    </figure>
  </section>

  <div class="overflow-hidden bg-lime-300 py-4 text-center text-[10px] font-black uppercase tracking-[0.2em] sm:py-5 sm:text-xs">
    NOVARA — Be different — Stay original — NOVARA — Be different — Stay original
  </div>

  <section data-horizontal-section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="mb-10 flex flex-col gap-6 sm:mb-14 sm:flex-row sm:items-end sm:justify-between">
      <div><span class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500">01 / Our collection</span><h2 data-text-reveal class="mt-4 text-4xl font-black uppercase leading-[0.95] tracking-[-0.06em] sm:text-6xl">Defined by<br />simplicity.</h2></div>
      <a data-magnetic href="/Projects" class="text-[10px] font-bold uppercase tracking-[0.15em] hover:text-neutral-500">View all products ↗</a>
    </div>
    <div data-horizontal-viewport class="overflow-x-auto">
    <div data-horizontal-track data-stagger class="flex w-max gap-5 pb-2 md:gap-6">
      <article class="group w-[78vw] shrink-0 sm:w-[52vw] md:w-[48vw] lg:w-[42vw]">
        <a data-image-reveal data-tilt href="/Projects" class="relative block aspect-[4/5] overflow-hidden bg-neutral-100"><img class="h-full w-full object-cover transition duration-700 group-hover:scale-105" src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=900&q=85" alt="Minimal white T-shirt" loading="lazy" /><span class="absolute left-4 top-4 bg-white px-3 py-2 text-[10px]">01</span></a>
        <div class="flex items-start justify-between pt-4"><div><h3 class="text-sm font-bold uppercase tracking-wide">Essential tee</h3><p class="mt-1 text-[9px] font-semibold tracking-[0.16em] text-neutral-500">EVERYDAY ESSENTIALS</p></div><span aria-hidden="true" class="text-lg">↗</span></div>
      </article>
      <article class="group w-[78vw] shrink-0 sm:w-[52vw] md:w-[48vw] lg:w-[42vw]">
        <a data-image-reveal data-tilt href="/Projects" class="relative block aspect-[4/5] overflow-hidden bg-neutral-100"><img class="h-full w-full object-cover transition duration-700 group-hover:scale-105" src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=900&q=85" alt="Minimal hoodie" loading="lazy" /><span class="absolute left-4 top-4 bg-white px-3 py-2 text-[10px]">02</span></a>
        <div class="flex items-start justify-between pt-4"><div><h3 class="text-sm font-bold uppercase tracking-wide">Oversized hoodie</h3><p class="mt-1 text-[9px] font-semibold tracking-[0.16em] text-neutral-500">MODERN COMFORT</p></div><span aria-hidden="true" class="text-lg">↗</span></div>
      </article>
      <article class="group w-[78vw] shrink-0 sm:w-[52vw] md:w-[48vw] lg:w-[42vw]">
        <a data-image-reveal data-tilt href="/Projects" class="relative block aspect-[4/5] overflow-hidden bg-neutral-100"><img class="h-full w-full object-cover transition duration-700 group-hover:scale-105" src="https://images.unsplash.com/photo-1503341504253-dff4815485f1?auto=format&fit=crop&w=900&q=85" alt="Contemporary streetwear outfit" loading="lazy" /><span class="absolute left-4 top-4 bg-white px-3 py-2 text-[10px]">03</span></a>
        <div class="flex items-start justify-between pt-4"><div><h3 class="text-sm font-bold uppercase tracking-wide">Urban series</h3><p class="mt-1 text-[9px] font-semibold tracking-[0.16em] text-neutral-500">STREET CULTURE</p></div><span aria-hidden="true" class="text-lg">↗</span></div>
      </article>
    </div>
    </div>
  </section>

  <section class="bg-neutral-950 px-5 py-20 text-center text-white sm:px-8 sm:py-32">
    <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-neutral-400">The NOVARA philosophy</span>
    <h2 data-text-reveal class="mx-auto mt-6 text-5xl font-black uppercase leading-[0.9] tracking-[-0.07em] sm:text-7xl lg:text-8xl">Less noise.<br />More <span data-scrub class="text-lime-300">identity.</span></h2>
    <p class="mx-auto mt-6 max-w-lg text-sm leading-7 text-neutral-400">We believe great style doesn't need to be complicated. Every detail matters. Every design has a purpose.</p>
    <a data-magnetic href="/About" class="mt-8 inline-flex items-center gap-3 bg-white px-6 py-4 text-[10px] font-bold uppercase tracking-[0.15em] text-neutral-950 hover:bg-lime-300">Our story ↗</a>
  </section>

  <section class="mx-auto grid max-w-[1440px] gap-10 px-5 py-20 sm:px-8 sm:py-28 md:grid-cols-[1.1fr_0.9fr] md:items-center md:gap-16 lg:px-12">
    <div data-image-reveal class="h-[380px] overflow-hidden bg-neutral-100 sm:h-[520px]"><img class="h-full w-full object-cover" src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1200&q=85" alt="Fashion editorial clothing collection" loading="lazy" /></div>
    <div><span class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500">02 / Our vision</span><h2 data-text-reveal class="mt-5 text-5xl font-black uppercase leading-[0.9] tracking-[-0.06em] sm:text-7xl">Fashion<br />without<br />limits.</h2><p data-reveal class="mt-6 max-w-md text-sm leading-7 text-neutral-600">NOVARA is built for individuals who express themselves through simplicity, confidence, and timeless fashion. Our vision is to create clothing that feels authentic and looks effortless.</p><a data-magnetic href="/About" class="mt-7 inline-block text-[10px] font-bold uppercase tracking-[0.15em] hover:text-neutral-500">Learn more ↗</a></div>
  </section>

  <section class="bg-neutral-100 px-5 py-20 text-center sm:px-8 sm:py-28">
    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500">Your style. Your statement.</span>
    <h2 data-text-reveal class="mt-5 text-5xl font-black uppercase leading-[0.9] tracking-[-0.07em] sm:text-7xl">Make it<br />your own.</h2>
    <a data-magnetic href="/Contact" class="mt-8 inline-flex items-center gap-3 bg-neutral-950 px-6 py-4 text-[10px] font-bold uppercase tracking-[0.15em] text-white hover:bg-lime-400 hover:text-neutral-950">Connect with us ↗</a>
  </section>
</BaseLayout>
