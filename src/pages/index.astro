---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="NOVARA | Modern Streetwear">
  <section class="mx-auto grid max-w-[1440px] px-5 py-8 sm:px-8 sm:py-12 lg:min-h-[680px] lg:grid-cols-[0.82fr_1.18fr] lg:px-12 lg:py-10">
    <div class="flex max-w-[560px] flex-col justify-center py-10 lg:pr-14 lg:py-12">
      <p class="flex items-center gap-3 text-[9px] font-bold uppercase tracking-[0.24em] text-neutral-500">
        <span class="h-px w-8 bg-lime-400"></span>
        Est. 2026 / Modern streetwear
      </p>
      <h1 data-text-reveal class="mt-7 text-[clamp(4.2rem,8.5vw,8.2rem)] font-black uppercase leading-[0.82] tracking-[-0.08em]">
        Wear your<br /><span class="text-neutral-400">identity.</span>
      </h1>
      <p class="mt-8 max-w-md text-sm leading-7 text-neutral-600 sm:text-[15px]">
        Essential pieces for self-expression. Designed to feel effortless, made to be lived in.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-7">
        <a data-magnetic href="/Projects" class="inline-flex items-center gap-8 border border-neutral-950 bg-neutral-950 px-6 py-4 text-[9px] font-bold uppercase tracking-[0.16em] text-white hover:bg-lime-300 hover:text-neutral-950">
          Explore collection <span aria-hidden="true">↗</span>
        </a>
        <a href="/About" class="border-b border-neutral-950 pb-1 text-[9px] font-bold uppercase tracking-[0.16em] hover:border-neutral-400 hover:text-neutral-500">Discover NOVARA</a>
      </div>
    </div>

    <figure data-image-reveal class="group relative min-h-[520px] overflow-hidden bg-neutral-100 sm:min-h-[620px] lg:min-h-0">
      <img class="h-full w-full object-cover object-[center_32%] transition duration-1000 group-hover:scale-[1.02]" src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1600&q=90" alt="Modern streetwear fashion model" />
      <div class="absolute inset-x-0 bottom-0 flex items-end justify-between bg-gradient-to-t from-black/55 to-transparent p-5 pt-24 text-white sm:p-8">
        <p class="text-[9px] font-bold uppercase leading-5 tracking-[0.18em]">Collection 001<br /><span class="text-white/65">Core / 2026</span></p>
        <p class="text-[9px] font-bold uppercase tracking-[0.18em]">01 — 06</p>
      </div>
    </figure>
  </section>

  <div class="border-y border-neutral-200">
    <div class="mx-auto grid max-w-[1440px] grid-cols-3 px-5 py-5 text-[8px] font-bold uppercase tracking-[0.16em] text-neutral-500 sm:px-8 sm:text-[9px] lg:px-12">
      <span>New collection</span>
      <span class="text-center">Designed in 2026</span>
      <span class="text-right">Worldwide</span>
    </div>
  </div>

  <section data-horizontal-section class="mx-auto max-w-[1440px] px-5 py-24 sm:px-8 sm:py-32 lg:px-12">
    <div class="mb-12 flex items-end justify-between">
      <div>
        <p class="text-[9px] font-bold uppercase tracking-[0.22em] text-neutral-500">01 / Selected pieces</p>
        <h2 data-text-reveal class="mt-5 text-5xl font-black uppercase leading-[0.86] tracking-[-0.07em] sm:text-7xl">The edit.</h2>
      </div>
      <a data-magnetic href="/Projects" class="hidden border-b border-neutral-950 pb-1 text-[9px] font-bold uppercase tracking-[0.16em] sm:block">View collection ↗</a>
    </div>
    <div data-horizontal-viewport class="-mx-5 overflow-x-auto px-5 sm:-mx-8 sm:px-8 lg:mx-0 lg:px-0">
      <div data-horizontal-track data-stagger class="grid w-full grid-cols-[repeat(3,minmax(280px,1fr))] gap-5 sm:min-w-[900px] lg:min-w-0 lg:gap-7">
        <article class="group">
          <a data-image-reveal data-tilt href="/Projects" class="relative block aspect-[4/5] overflow-hidden bg-neutral-100">
            <img class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]" src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=900&q=85" alt="Minimal white T-shirt" loading="lazy" />
            <span class="absolute left-4 top-4 bg-white px-3 py-2 text-[9px] font-bold">01</span>
          </a>
          <div class="flex items-start justify-between pt-5"><div><h3 class="text-xs font-bold uppercase tracking-[0.12em]">Essential tee</h3><p class="mt-2 text-[8px] font-bold tracking-[0.18em] text-neutral-400">EVERYDAY / WHITE</p></div><span aria-hidden="true" class="text-sm">↗</span></div>
        </article>
        <article class="group mt-0 lg:mt-12">
          <a data-image-reveal data-tilt href="/Projects" class="relative block aspect-[4/5] overflow-hidden bg-neutral-100">
            <img class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]" src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=900&q=85" alt="Minimal hoodie" loading="lazy" />
            <span class="absolute left-4 top-4 bg-white px-3 py-2 text-[9px] font-bold">02</span>
          </a>
          <div class="flex items-start justify-between pt-5"><div><h3 class="text-xs font-bold uppercase tracking-[0.12em]">Oversized hoodie</h3><p class="mt-2 text-[8px] font-bold tracking-[0.18em] text-neutral-400">MODERN / STONE</p></div><span aria-hidden="true" class="text-sm">↗</span></div>
        </article>
        <article class="group">
          <a data-image-reveal data-tilt href="/Projects" class="relative block aspect-[4/5] overflow-hidden bg-neutral-100">
            <img class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]" src="https://images.unsplash.com/photo-1503341504253-dff4815485f1?auto=format&fit=crop&w=900&q=85" alt="Contemporary streetwear outfit" loading="lazy" />
            <span class="absolute left-4 top-4 bg-white px-3 py-2 text-[9px] font-bold">03</span>
          </a>
          <div class="flex items-start justify-between pt-5"><div><h3 class="text-xs font-bold uppercase tracking-[0.12em]">Urban series</h3><p class="mt-2 text-[8px] font-bold tracking-[0.18em] text-neutral-400">STREET / BLACK</p></div><span aria-hidden="true" class="text-sm">↗</span></div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-neutral-950 px-5 py-24 text-white sm:px-8 sm:py-32 lg:px-12">
    <div class="mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-[0.35fr_0.65fr] lg:items-end">
      <p class="text-[9px] font-bold uppercase tracking-[0.22em] text-neutral-500">02 / Our philosophy</p>
      <div>
        <h2 data-text-reveal class="text-5xl font-black uppercase leading-[0.88] tracking-[-0.07em] sm:text-7xl lg:text-[7.5rem]">
          Less noise.<br />More <span data-scrub class="text-lime-300">identity.</span>
        </h2>
        <div class="mt-10 flex flex-col gap-8 border-t border-white/15 pt-7 sm:flex-row sm:items-end sm:justify-between">
          <p class="max-w-md text-sm leading-7 text-neutral-400">Every detail matters. We create considered clothing that gives you room to define your own expression.</p>
          <a data-magnetic href="/About" class="inline-flex w-fit items-center gap-8 border-b border-white pb-2 text-[9px] font-bold uppercase tracking-[0.16em] hover:border-lime-300 hover:text-lime-300">Our story ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1440px] gap-10 px-5 py-24 sm:px-8 sm:py-32 md:grid-cols-[1.08fr_0.92fr] md:items-center md:gap-16 lg:px-12">
    <div data-image-reveal class="h-[440px] overflow-hidden bg-neutral-100 sm:h-[600px]">
      <img class="h-full w-full object-cover" src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1400&q=85" alt="Fashion editorial clothing collection" loading="lazy" />
    </div>
    <div class="md:pr-8">
      <p class="text-[9px] font-bold uppercase tracking-[0.22em] text-neutral-500">03 / Our vision</p>
      <h2 data-text-reveal class="mt-6 text-5xl font-black uppercase leading-[0.86] tracking-[-0.07em] sm:text-7xl">Beyond<br />the season.</h2>
      <p data-reveal class="mt-8 max-w-md text-sm leading-7 text-neutral-600">We believe clothing should outlast trends. NOVARA creates timeless forms with a modern point of view—simple, intentional, and unmistakably yours.</p>
      <a data-magnetic href="/About" class="mt-8 inline-flex items-center gap-8 border-b border-neutral-950 pb-2 text-[9px] font-bold uppercase tracking-[0.16em] hover:border-neutral-400 hover:text-neutral-500">Learn more ↗</a>
    </div>
  </section>

  <section class="border-t border-neutral-200 px-5 py-20 sm:px-8 sm:py-24 lg:px-12">
    <div class="mx-auto flex max-w-[1440px] flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[9px] font-bold uppercase tracking-[0.22em] text-neutral-500">Your style. Your statement.</p>
        <h2 data-text-reveal class="mt-5 text-5xl font-black uppercase leading-[0.86] tracking-[-0.07em] sm:text-7xl">Make it yours.</h2>
      </div>
      <a data-magnetic href="/Contact" class="inline-flex w-fit items-center gap-10 bg-neutral-950 px-7 py-5 text-[9px] font-bold uppercase tracking-[0.16em] text-white hover:bg-lime-300 hover:text-neutral-950">Start a conversation <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
