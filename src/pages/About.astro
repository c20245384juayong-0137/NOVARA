
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | NOVARA">

  <section class="about-hero">
    <span class="section-label">GET TO KNOW US / 01</span>
    <h1>WE ARE<br /><span>NOVARA.</span></h1>
    <p>A modern clothing brand built around individuality, simplicity, and timeless style.</p>
  </section>

  <section class="about-image">
    <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1800&q=85" alt="NOVARA fashion editorial" />
  </section>

  <section class="about-story">
    <div>
      <span class="section-label">OUR STORY</span>
      <h2>STYLE IS<br />PERSONAL.</h2>
    </div>
    <div>
      <p>
        NOVARA represents a new perspective on everyday fashion.
        We believe clothing is more than something you wear.
        It is an expression of who you are.
      </p>
      <p>
        Inspired by minimalism and modern street culture,
        NOVARA creates a visual identity that values simplicity,
        quality, and individuality.
      </p>
    </div>
  </section>

  <section class="values">
    <div class="value-card">
      <span>01</span>
      <h3>SIMPLICITY</h3>
      <p>Clean designs that communicate without unnecessary details.</p>
    </div>
    <div class="value-card">
      <span>02</span>
      <h3>IDENTITY</h3>
      <p>Clothing that allows individuals to express their personality.</p>
    </div>
    <div class="value-card">
      <span>03</span>
      <h3>QUALITY</h3>
      <p>Thoughtful design with attention to every detail.</p>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    padding: 120px 7%;
    background: #f5f5f5;
  }

  .about-hero h1 {
    font-size: clamp(65px, 12vw, 150px);
    font-weight: 900;
    line-height: .85;
    letter-spacing: -9px;
    margin: 35px 0;
  }

  .about-hero h1 span { color: #999; }

  .about-hero p {
    max-width: 450px;
    color: #777;
    line-height: 2;
    font-size: 14px;
  }

  .about-image {
    height: 570px;
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-story {
    padding: 120px 7%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }

  .about-story h2 {
    font-size: 65px;
    font-weight: 900;
    letter-spacing: -4px;
    line-height: .95;
    margin-top: 25px;
  }

  .about-story p {
    color: #777;
    font-size: 14px;
    line-height: 2;
    margin-bottom: 25px;
  }

  .values {
    padding: 80px 7%;
    background: #080808;
    color: white;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .value-card span {
    color: #777;
    font-size: 12px;
  }

  .value-card h3 {
    font-size: 20px;
    margin: 30px 0 15px;
    letter-spacing: 1px;
  }

  .value-card p {
    color: #888;
    font-size: 12px;
    line-height: 1.9;
  }

  @media(max-width: 650px) {
    .about-hero h1 { letter-spacing: -4px; }
    .about-story, .values { grid-template-columns: 1fr; gap: 40px; }
    .about-image { height: 350px; }
  }
</style>
