---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | NOVARA">
  <section class="bg-neutral-100 px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="mx-auto max-w-[1440px]">
      <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-neutral-500">Get to know us / 01</span>
      <h1 data-text-reveal class="mt-7 text-[clamp(4rem,12vw,10rem)] font-black uppercase leading-[0.82] tracking-[-0.08em]">We are<br /><span class="text-neutral-400">NOVARA.</span></h1>
      <p class="mt-8 max-w-lg text-sm leading-7 text-neutral-600 sm:text-base">A modern clothing brand built around individuality, simplicity, and timeless style.</p>
    </div>
  </section>
  <figure data-image-reveal class="h-[360px] overflow-hidden bg-neutral-200 sm:h-[500px] lg:h-[640px]"><img class="h-full w-full object-cover" src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1800&q=85" alt="NOVARA fashion editorial" loading="lazy" /></figure>
  <section class="mx-auto grid max-w-[1440px] gap-8 px-5 py-20 sm:px-8 sm:py-28 md:grid-cols-2 md:gap-20 lg:px-12">
    <div><span class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500">Our story</span><h2 data-text-reveal class="mt-5 text-5xl font-black uppercase leading-[0.9] tracking-[-0.06em] sm:text-6xl">Style is<br />personal.</h2></div>
    <div data-reveal class="max-w-xl text-sm leading-7 text-neutral-600"><p>NOVARA represents a new perspective on everyday fashion. We believe clothing is more than something you wear. It is an expression of who you are.</p><p class="mt-5">Inspired by minimalism and modern street culture, NOVARA creates a visual identity that values simplicity, quality, and individuality.</p></div>
  </section>
  <section class="bg-neutral-950 text-white">
    <div data-stagger class="mx-auto grid max-w-[1440px] gap-px bg-white/15 px-5 py-12 sm:px-8 md:grid-cols-3 lg:px-12">
      <article class="bg-neutral-950 py-8 md:pr-10"><span class="text-xs text-neutral-500">01</span><h3 class="mt-9 text-xl font-bold tracking-wide">SIMPLICITY</h3><p class="mt-3 max-w-xs text-sm leading-6 text-neutral-400">Clean designs that communicate without unnecessary details.</p></article>
      <article class="bg-neutral-950 py-8 md:px-10"><span class="text-xs text-neutral-500">02</span><h3 class="mt-9 text-xl font-bold tracking-wide">IDENTITY</h3><p class="mt-3 max-w-xs text-sm leading-6 text-neutral-400">Clothing that allows individuals to express their personality.</p></article>
      <article class="bg-neutral-950 py-8 md:pl-10"><span class="text-xs text-neutral-500">03</span><h3 class="mt-9 text-xl font-bold tracking-wide">QUALITY</h3><p class="mt-3 max-w-xs text-sm leading-6 text-neutral-400">Thoughtful design with attention to every detail.</p></article>
    </div>
  </section>
</BaseLayout>
