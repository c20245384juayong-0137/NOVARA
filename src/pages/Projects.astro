---
import BaseLayout from "../layouts/BaseLayout.astro";

const products = [
  { name: "Essential White Tee", category: "ESSENTIALS", number: "01", image: "photo-1521572163474-6864f9cf17ab" },
  { name: "Classic Black Tee", category: "ESSENTIALS", number: "02", image: "photo-1503341504253-dff4815485f1" },
  { name: "Oversized Hoodie", category: "OUTERWEAR", number: "03", image: "photo-1556821840-3a63f95609a7" },
  { name: "Urban Streetwear", category: "STREETWEAR", number: "04", image: "photo-1529139574466-a303027c1d8b" },
  { name: "Modern Outfit", category: "COLLECTION", number: "05", image: "photo-1483985988355-763728e1935b" },
  { name: "Minimal Fashion", category: "COLLECTION", number: "06", image: "photo-1539109136881-3be0616acf4b" },
];
---

<BaseLayout title="Collection | NOVARA">
  <section class="bg-neutral-100 px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="mx-auto max-w-[1440px]">
      <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-neutral-500">NOVARA / Collection 001</span>
      <h1 data-text-reveal class="mt-7 text-[clamp(4rem,12vw,10rem)] font-black uppercase leading-[0.82] tracking-[-0.08em]">The art of<br /><span class="text-neutral-400">everyday.</span></h1>
      <p class="mt-8 text-sm leading-7 text-neutral-600">Designed with intention. Created for individuality.</p>
    </div>
  </section>
  <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-24 lg:px-12">
    <div data-reveal class="mb-8 flex justify-between border-b border-neutral-200 pb-4 text-[9px] font-bold uppercase tracking-[0.18em] sm:text-[10px]"><span>Our selection</span><span>06 featured looks</span></div>
    <div data-stagger class="grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-14">
      {products.map((product) => (
        <article class="group">
          <a data-image-reveal data-tilt href="/Contact" aria-label={`Ask about ${product.name}`} class="relative block aspect-[4/5] overflow-hidden bg-neutral-100">
            <img class="h-full w-full object-cover transition duration-700 group-hover:scale-105" src={`https://images.unsplash.com/${product.image}?auto=format&fit=crop&w=900&q=85`} alt={product.name} loading="lazy" />
            <span class="absolute left-4 top-4 bg-white px-3 py-2 text-[10px]">{product.number}</span>
          </a>
          <div class="flex items-start justify-between pt-4">
            <div><h2 class="text-sm font-bold uppercase tracking-wide">{product.name}</h2><p class="mt-1 text-[9px] font-semibold tracking-[0.16em] text-neutral-500">{product.category}</p></div>
            <span class="text-lg" aria-hidden="true">↗</span>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
