---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  { number: "01", title: "EVERYDAY WEAR", description: "Minimal clothing designed for everyday comfort and effortless style." },
  { number: "02", title: "STREETWEAR", description: "Modern streetwear inspired by individuality and urban culture." },
  { number: "03", title: "BASIC ESSENTIALS", description: "Timeless wardrobe essentials with clean and versatile designs." },
  { number: "04", title: "EXCLUSIVE COLLECTIONS", description: "Distinctive clothing releases that reflect the NOVARA identity." }
];
---

<BaseLayout title="Services | NOVARA">
  <section class="bg-neutral-100 px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="mx-auto max-w-[1440px]">
      <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-neutral-500">What we offer / 03</span>
      <h1 data-text-reveal class="mt-7 text-[clamp(3.8rem,11vw,9rem)] font-black uppercase leading-[0.84] tracking-[-0.08em]">Made for<br /><span class="text-neutral-400">your style.</span></h1>
      <p class="mt-8 text-sm leading-7 text-neutral-600">Discover clothing designed to complement your everyday identity.</p>
    </div>
  </section>
  <section class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 sm:py-24 lg:px-12">
    <div data-stagger class="divide-y divide-neutral-200 border-y border-neutral-200">
      {services.map((service) => (
        <article class="grid grid-cols-[2rem_1fr_auto] items-start gap-4 py-7 sm:grid-cols-[3.5rem_1fr_1fr_auto] sm:items-center sm:gap-6 sm:py-9">
          <span class="pt-1 text-xs text-neutral-400">{service.number}</span>
          <h2 class="text-lg font-bold uppercase tracking-tight sm:text-xl">{service.title}</h2>
          <p class="col-start-2 text-sm leading-6 text-neutral-600 sm:col-start-auto">{service.description}</p>
          <span class="row-start-1 text-xl sm:row-auto" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>
  <section class="bg-neutral-950 px-5 py-20 text-center text-white sm:px-8 sm:py-28">
    <h2 data-text-reveal class="text-5xl font-black uppercase leading-[0.9] tracking-[-0.07em] sm:text-7xl">Simplicity<br />is the new<br /><span class="text-lime-300">statement.</span></h2>
    <a data-magnetic class="mt-9 inline-flex items-center gap-3 border border-white/60 px-6 py-4 text-[10px] font-bold uppercase tracking-[0.15em] hover:border-lime-300 hover:bg-lime-300 hover:text-neutral-950" href="/Projects">Explore our collection <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
