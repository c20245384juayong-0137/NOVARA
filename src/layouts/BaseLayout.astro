
---
import "../styles/global.css";

const { title = "NOVARA | Modern Streetwear", description = "NOVARA — Minimalist streetwear for modern individuals." } = Astro.props;

const navLinks = [
  { name: "HOME", href: "/" },
  { name: "ABOUT", href: "/About" },
  { name: "COLLECTION", href: "/Projects" },
  { name: "PROCESS", href: "/Process" },
  { name: "SERVICES", href: "/Services" },
  { name: "CONTACT", href: "/Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body id="top" class="min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-bold">Skip to content</a>
    <header class="sticky top-0 z-50 border-b border-neutral-200/80 bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-[76px] max-w-[1440px] items-center justify-between px-5 sm:px-8 lg:px-12">
      <a href="/" class="flex items-center gap-3 text-lg font-black tracking-[0.24em]" aria-label="NOVARA home">
        <span class="grid size-9 place-items-center bg-neutral-950 text-lg font-bold tracking-normal text-white">N</span>
        <span>NOVARA<span class="text-lime-600">.</span></span>
      </a>

      <nav class="nav-links absolute left-0 right-0 top-[75px] hidden flex-col gap-1 border-b border-neutral-200 bg-white px-5 py-5 sm:px-8 md:static md:flex md:flex-row md:items-center md:gap-7 md:border-0 md:bg-transparent md:p-0 lg:gap-9" id="primary-navigation" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a href={link.href} aria-current={Astro.url.pathname.toLowerCase() === link.href.toLowerCase() ? "page" : undefined} class:list={["py-2 text-[11px] font-bold tracking-[0.14em] text-neutral-600 hover:text-neutral-950 md:py-3", { "text-neutral-950": Astro.url.pathname.toLowerCase() === link.href.toLowerCase() }]}>
            {link.name}
          </a>
        ))}
      </nav>

      <a href="/Contact" class="hidden items-center gap-2 bg-neutral-950 px-5 py-3 text-[10px] font-bold tracking-[0.13em] text-white hover:bg-lime-400 hover:text-neutral-950 md:inline-flex">LET'S TALK <span aria-hidden="true">↗</span></a>

      <button class="menu-toggle grid size-11 place-items-center border border-neutral-200 md:hidden" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false">
        <span class="flex flex-col gap-1.5" aria-hidden="true"><span class="h-0.5 w-5 bg-neutral-950"></span><span class="h-0.5 w-5 bg-neutral-950"></span></span>
      </button>
      </div>
    </header>

    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>

    <footer class="bg-neutral-950 text-white">
      <div class="mx-auto max-w-[1440px] px-5 pb-8 pt-16 sm:px-8 lg:px-12 lg:pt-20">
        <div class="flex flex-col justify-between gap-10 border-b border-white/15 pb-12 md:flex-row md:items-start">
          <div>
            <a href="/" class="text-3xl font-black tracking-[0.2em]">NOVARA<span class="text-lime-400">.</span></a>
            <p class="mt-4 text-sm text-neutral-400">Minimal design. Maximum expression.</p>
          </div>
          <nav class="flex flex-wrap gap-x-7 gap-y-4 text-xs font-medium text-neutral-400" aria-label="Footer navigation">
            <a class="hover:text-white" href="/">Home</a>
            <a class="hover:text-white" href="/About">About</a>
            <a class="hover:text-white" href="/Projects">Collection</a>
            <a class="hover:text-white" href="/Process">Process</a>
            <a class="hover:text-white" href="/Contact">Contact</a>
          </nav>
        </div>
        <div class="flex flex-col gap-3 pt-6 text-[9px] font-semibold tracking-[0.16em] text-neutral-500 sm:flex-row sm:justify-between">
          <p>© {new Date().getFullYear()} NOVARA. ALL RIGHTS RESERVED.</p>
          <p>DESIGNED FOR THE MODERN GENERATION.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector(".menu-toggle");
      const nav = document.querySelector(".nav-links");

      toggle?.addEventListener("click", () => {
        const isOpen = nav?.classList.toggle("show");
        nav?.classList.toggle("hidden", !isOpen);
        nav?.classList.toggle("flex", Boolean(isOpen));
        toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
        toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      });

      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          nav.classList.remove("show", "flex");
          nav.classList.add("hidden");
          toggle?.setAttribute("aria-expanded", "false");
          toggle?.setAttribute("aria-label", "Open navigation");
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && nav?.classList.contains("show")) {
          nav.classList.remove("show", "flex");
          nav.classList.add("hidden");
          toggle?.setAttribute("aria-expanded", "false");
          toggle?.setAttribute("aria-label", "Open navigation");
          (toggle as HTMLElement | null)?.focus();
        }
      });
    </script>
    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>
